<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens. Views reference these keys only (DynamicResource), never raw colours or sizes.
    Palette: low-contrast graphite surfaces, one restrained accent, status colours used sparingly.
    Three background levels: Base → Surface → Elevated.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgBaseColor">#0D0F12</Color>
      <Color x:Key="BgSurfaceColor">#13161B</Color>
      <Color x:Key="BgElevatedColor">#1A1E24</Color>
      <Color x:Key="BgHoverColor">#20252C</Color>
      <Color x:Key="BgPressedColor">#262C34</Color>
      <Color x:Key="BorderColor">#252A31</Color>
      <Color x:Key="BorderSubtleColor">#1C2026</Color>
      <Color x:Key="BorderStrongColor">#343A43</Color>
      <Color x:Key="TextPrimaryColor">#E4E7EC</Color>
      <Color x:Key="TextSecondaryColor">#8D95A3</Color>
      <Color x:Key="TextDisabledColor">#565D68</Color>
      <Color x:Key="AccentColor">#6B8EF5</Color>
      <Color x:Key="AccentHoverColor">#7F9DF7</Color>
      <Color x:Key="AccentMutedColor">#1B2438</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="SuccessColor">#4CB66A</Color>
      <Color x:Key="WarningColor">#D4A23C</Color>
      <Color x:Key="DangerColor">#EF6461</Color>
      <Color x:Key="DangerMutedColor">#2A1719</Color>
      <Color x:Key="HitColor">#4A3D14</Color>
      <Color x:Key="NewRowColor">#14281E</Color>
      <Color x:Key="SelectionColor">#1E2A44</Color>
      <Color x:Key="SyntaxFieldColor">#82B4F5</Color>
      <Color x:Key="SyntaxOperatorColor">#C79BF0</Color>
      <Color x:Key="SyntaxStringColor">#9FCF9E</Color>
      <Color x:Key="SyntaxParameterColor">#F0AE6A</Color>
      <Color x:Key="SyntaxRangeColor">#7CC4BB</Color>
      <Color x:Key="SyntaxNumberColor">#E2C26A</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgBaseColor">#F5F6F8</Color>
      <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
      <Color x:Key="BgElevatedColor">#F0F2F5</Color>
      <Color x:Key="BgHoverColor">#EAEDF1</Color>
      <Color x:Key="BgPressedColor">#E2E6EC</Color>
      <Color x:Key="BorderColor">#E0E3E8</Color>
      <Color x:Key="BorderSubtleColor">#ECEEF2</Color>
      <Color x:Key="BorderStrongColor">#CDD2DA</Color>
      <Color x:Key="TextPrimaryColor">#1B1E24</Color>
      <Color x:Key="TextSecondaryColor">#5F6775</Color>
      <Color x:Key="TextDisabledColor">#A4AAB4</Color>
      <Color x:Key="AccentColor">#3563D9</Color>
      <Color x:Key="AccentHoverColor">#2B57C7</Color>
      <Color x:Key="AccentMutedColor">#EAF0FD</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="SuccessColor">#23874A</Color>
      <Color x:Key="WarningColor">#9A6A05</Color>
      <Color x:Key="DangerColor">#C9343A</Color>
      <Color x:Key="DangerMutedColor">#FCEDEE</Color>
      <Color x:Key="HitColor">#FFECA8</Color>
      <Color x:Key="NewRowColor">#E5F5EA</Color>
      <Color x:Key="SelectionColor">#E3EAFB</Color>
      <Color x:Key="SyntaxFieldColor">#1D5FB0</Color>
      <Color x:Key="SyntaxOperatorColor">#8840B8</Color>
      <Color x:Key="SyntaxStringColor">#2F7A3A</Color>
      <Color x:Key="SyntaxParameterColor">#B85A0B</Color>
      <Color x:Key="SyntaxRangeColor">#11756A</Color>
      <Color x:Key="SyntaxNumberColor">#8F6300</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource BgBaseColor}" />
  <SolidColorBrush x:Key="BgSurfaceBrush" Color="{DynamicResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="BgElevatedBrush" Color="{DynamicResource BgElevatedColor}" />
  <SolidColorBrush x:Key="BgHoverBrush" Color="{DynamicResource BgHoverColor}" />
  <SolidColorBrush x:Key="BgPressedBrush" Color="{DynamicResource BgPressedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource AccentMutedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerMutedBrush" Color="{DynamicResource DangerMutedColor}" />
  <SolidColorBrush x:Key="HitBrush" Color="{DynamicResource HitColor}" />
  <SolidColorBrush x:Key="NewRowBrush" Color="{DynamicResource NewRowColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="SyntaxFieldBrush" Color="{DynamicResource SyntaxFieldColor}" />
  <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="{DynamicResource SyntaxOperatorColor}" />
  <SolidColorBrush x:Key="SyntaxStringBrush" Color="{DynamicResource SyntaxStringColor}" />
  <SolidColorBrush x:Key="SyntaxParameterBrush" Color="{DynamicResource SyntaxParameterColor}" />
  <SolidColorBrush x:Key="SyntaxRangeBrush" Color="{DynamicResource SyntaxRangeColor}" />
  <SolidColorBrush x:Key="SyntaxNumberBrush" Color="{DynamicResource SyntaxNumberColor}" />

  <!-- ── Fluent overrides: colours ─────────────────────────────────────────── -->
  <Color x:Key="SystemAccentColor">#6B8EF5</Color>
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource BgElevatedColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource BgHoverColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource BgPressedColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="{DynamicResource BgElevatedColor}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{DynamicResource BgHoverColor}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{DynamicResource BgPressedColor}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{DynamicResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{DynamicResource AccentMutedColor}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{DynamicResource AccentMutedColor}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{DynamicResource AccentHoverColor}" />

  <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{DynamicResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{DynamicResource BgHoverColor}" />
  <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{DynamicResource BgPressedColor}" />
  <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{DynamicResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{DynamicResource SelectionColor}" />
  <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
  <Color x:Key="DataGridRowHoveredBackgroundColor">#10808080</Color>
  <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />

  <!-- ── Fluent overrides: density & type (data tool, not touch UI) ─────────── -->
  <x:Double x:Key="ControlContentThemeFontSize">12.5</x:Double>
  <x:Double x:Key="ToolTipContentThemeFontSize">11.5</x:Double>
  <x:Double x:Key="TabItemHeaderFontSize">12.5</x:Double>
  <x:Double x:Key="TabItemMinHeight">32</x:Double>
  <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
  <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>
  <Thickness x:Key="ButtonPadding">10,4,10,4</Thickness>
  <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
  <Thickness x:Key="ComboBoxPadding">8,3,0,3</Thickness>
  <Thickness x:Key="ComboBoxItemThemePadding">10,5,10,5</Thickness>
  <x:Double x:Key="DropDownButtonMinHeight">28</x:Double>
  <x:Double x:Key="CheckBoxMinHeight">24</x:Double>
  <x:Double x:Key="RadioButtonMinHeight">24</x:Double>
  <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
  <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePadding">10,5,10,5</Thickness>
  <Thickness x:Key="FlyoutContentThemePadding">14,12,14,12</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">8,4,8,5</Thickness>
  <x:Double x:Key="ProgressBarThemeMinHeight">2</x:Double>

  <!-- ── Shape & spacing (8px grid, 4px half-steps) ─────────────────────────── -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>

  <!-- ── Typography ─────────────────────────────────────────────────────────── -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
  <x:Double x:Key="FontSizeXs">10.5</x:Double>
  <x:Double x:Key="FontSizeSm">11.5</x:Double>
  <x:Double x:Key="FontSizeMd">12.5</x:Double>
  <x:Double x:Key="FontSizeLg">14</x:Double>
  <x:Double x:Key="FontSizeXl">15</x:Double>
  <x:Double x:Key="FontSizeMono">12</x:Double>

